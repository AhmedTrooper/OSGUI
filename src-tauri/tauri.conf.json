{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roletect",
  "version": "0.1.5",
  "identifier": "com.ahmedtrooper.roletect",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Roletect",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "zoomHotkeysEnabled": false,
        "minWidth": 400,
        "minHeight": 400
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3ODM5N0U2OTBCMTU4QQpSV1NLRlF0cGZqbDRCeXF5TWFkU202Y0J4RDdlUVVxd0VyVDJsTlY2UVFCbWh5ZnJ0ZXZvS0FvTwo=",
      "endpoints": [
        "https://github.com/AhmedTrooper/RoleTect/releases/latest/download/latest.json"
      ]
    }
  }
}
